generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  password           String
  role               String    @default("TECHNICIAN") // DISPATCHER | TECHNICIAN
  phone              String?
  lastKnownLat       Float?
  lastKnownLng       Float?
  lastLocationUpdate DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedJobs Job[] @relation("TechnicianJobs")
}

model Job {
  id              String    @id @default(uuid())
  title           String
  description     String    @db.Text
  customerName    String
  customerEmail   String?
  customerPhone   String
  customerAddress String    @db.Text
  latitude        Float?
  longitude       Float?
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | EMERGENCY
  status          String    @default("PENDING") // PENDING | EN_ROUTE | IN_PROGRESS | COMPLETED | CANCELLED
  
  // Offline sync & concurrency tracking
  version         Int       @default(1)
  clientUpdatedAt DateTime?
  syncedAt        DateTime?

  // Live GPS tracking
  lastKnownLat       Float?
  lastKnownLng       Float?
  lastLocationUpdate DateTime?

  // Completion artifacts
  completionNotes     String?   @db.Text
  completionEmailSent Boolean   @default(false)
  signatureData       String?   @db.Text
  signatureSvg        String?   @db.Text
  completedAt         DateTime?
  completedLatitude   Float?
  completedLongitude  Float?
  beforePhotoUrl      String?   @db.Text
  afterPhotoUrl       String?   @db.Text
  materialsUsed       String?   @db.Text

  // Financial & On-Spot Settlement Fields
  laborCost          Float     @default(50.0)
  customServices     String?   @db.Text // JSON array string: [{ "description": string, "amount": number }]
  totalAmount        Float     @default(50.0)
  paymentStatus      String    @default("UNPAID") // UNPAID | PAID
  paymentMethod      String?   // CASH_ON_SITE | ONLINE_TRANSFER
  paymentNotes       String?   @db.Text // e.g., cash receiver note or bank reference code

  // Relations
  technicianId    String?
  technician      User?     @relation("TechnicianJobs", fields: [technicianId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model InventoryItem {
  id              String   @id @default(uuid())
  name            String
  sku             String   @unique
  unitCost        Float
  quantityInStock Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model IdempotencyRecord {
  id              String   @id @default(uuid())
  key             String   @unique
  mutationType    String
  jobId           String?
  responsePayload String   @db.Text
  createdAt       DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt
}
